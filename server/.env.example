# Template for server/.env — copy this file, then fill in your own values.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Never commit the real .env; it is git-ignored.

# Port the Express API listens on.
PORT=4000

# MySQL connection.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=gcare_lms

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
